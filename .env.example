# ---------------------------------------------------------------------------
# FZIP Locker - environment template
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#     docker compose run --rm --no-deps api python -m scripts.gen_secrets
#
# .env is gitignored. Every FZIP_* variable below is REQUIRED - the server
# validates them at startup via pydantic-settings and refuses to boot if one
# is missing or malformed. There are deliberately no insecure defaults.
# ---------------------------------------------------------------------------

# --- MongoDB --------------------------------------------------------------
# Root credentials, used only by the container's entrypoint to bootstrap.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_root_password

# Least-privilege application user (readWrite on FZIP_MONGO_DB only).
# Created by docker/mongo-init.js on first boot.
MONGO_APP_USERNAME=fzip_app
MONGO_APP_PASSWORD=CHANGE_ME_app_password

FZIP_MONGO_DB=fzip

# --- Server secrets -------------------------------------------------------
# 32 random bytes, base64. Wraps face embeddings at rest (AES-256-GCM).
# Losing this makes every enrolled face unreadable; leaking it exposes
# biometric templates. Generate with scripts/gen_secrets.py.
FZIP_BIOMETRIC_KEY=CHANGE_ME_base64_32_bytes

# Ed25519 private key (PKCS#8 PEM, base64-encoded single line) for signing
# access tokens. EdDSA, not a shared HS256 secret.
FZIP_JWT_PRIVATE_KEY=CHANGE_ME_base64_pkcs8_pem
FZIP_JWT_KEY_ID=k1

# --- Token lifetimes ------------------------------------------------------
FZIP_ACCESS_TOKEN_TTL_SECONDS=900
FZIP_REFRESH_TOKEN_TTL_SECONDS=2592000
FZIP_FACE_CHALLENGE_TTL_SECONDS=60
FZIP_FACE_TOKEN_TTL_SECONDS=120

# --- Face recognition -----------------------------------------------------
# SFace's calibrated cosine-similarity threshold. Higher = stricter.
FZIP_FACE_MATCH_THRESHOLD=0.363
# Frames required to satisfy a head-turn liveness challenge.
FZIP_FACE_LIVENESS_FRAMES=5

# --- Rate limiting --------------------------------------------------------
FZIP_LOGIN_MAX_ATTEMPTS=6
FZIP_LOGIN_LOCKOUT_SECONDS=900

# --- Argon2id (password hashing) -----------------------------------------
# time_cost, memory in KiB, parallelism. Raise as hardware improves; existing
# hashes are transparently upgraded on next successful login.
FZIP_ARGON2_TIME_COST=3
FZIP_ARGON2_MEMORY_KIB=65536
FZIP_ARGON2_PARALLELISM=4

# --- SMTP -----------------------------------------------------------------
# Defaults point at the Mailpit container (web UI on http://localhost:8025).
# For real mail, set a real host and use an app password - never a hardcoded
# one in source, which is what the 2022 version did.
FZIP_SMTP_HOST=mailpit
FZIP_SMTP_PORT=1025
FZIP_SMTP_USERNAME=
FZIP_SMTP_PASSWORD=
FZIP_SMTP_USE_TLS=false
FZIP_SMTP_FROM=noreply@fziplocker.local

# --- App ------------------------------------------------------------------
FZIP_ENV=development
FZIP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Client (read by `uv run fzip-client`, not by Compose)
# ---------------------------------------------------------------------------
# FZIP_API_URL=https://localhost:8443
# FZIP_CA_BUNDLE=./certs/root.crt

# Mirrors .gitignore so secrets never enter a build context or leak into an
# image layer. Docker build contexts ignore .gitignore entirely, so this file
# has to repeat the rules rather than reference them.

.git/
.github/

# Secrets & certificates
.env
.env.*
!.env.example
certs/
*.key
*.pem
*.crt
*.p12
*.pfx

# Vault artifacts
*.lck

# The desktop client is never built into a server image
client/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docs are not needed at runtime
docs/
*.md
!README.md
